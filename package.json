{
	"name": "simple-graph-builder",
	"version": "0.10.0",
	"description": "Build a knowledge graph from your notes using LLM-powered entity extraction, and let AI agents search it over MCP. Supports Claude, OpenAI, Gemini, DeepSeek, and Ollama.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node tests/run.mjs",
		"eval": "node tests/run.mjs --eval",
		"lint": "eslint src/ --max-warnings 0",
		"lint:fix": "eslint src/ --fix --max-warnings 0"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"knowledge-graph",
		"entity-extraction",
		"llm",
		"ai"
	],
	"author": "Junhewk Kim",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@xmldom/xmldom": "^0.9.12",
		"esbuild": "0.17.3",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"cytoscape": "^3.33.1",
		"cytoscape-fcose": "^2.2.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"graphology-layout-forceatlas2": "^0.10.1"
	}
}
