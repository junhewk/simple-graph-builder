{
	"name": "simple-graph-builder",
	"version": "0.3.3",
	"description": "Build a knowledge graph from your notes using LLM-powered entity extraction. Supports Claude, OpenAI, Gemini, and Ollama.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"knowledge-graph",
		"entity-extraction",
		"llm",
		"ai"
	],
	"author": "Junhewk Kim",
	"license": "MIT",
	"devDependencies": {
		"eslint-plugin-obsidianmd": "^0.1.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^9.0.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"cytoscape": "^3.33.1",
		"cytoscape-fcose": "^2.2.0"
	}
}
